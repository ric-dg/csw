#!/bin/sh
# fake GNU wget: headers only via --config; fails the test if a secret is in argv
[ "${1-}" = --version ] && { echo 'GNU Wget 1.25.0 built on linux-gnu.'; exit 0; }
case "$*" in *SECRET*|*REFRESH*) echo leak >>"$FAKE_STATE/leaks"; exit 99 ;; esac
cfg='' b='' url=''
while [ $# -gt 0 ]; do
	case $1 in
	-q | --https-only | --secure-protocol=*) ;;
	-O | -T | -U) shift ;;
	--config=*) cfg=${1#*=} ;;
	--post-file=*) b=${1#*=} ;;
	-*) echo "fake GNU wget: unexpected option $1" >&2; exit 2 ;;
	*) url=$1 ;;
	esac
	shift
done
h=$(mktemp); sed -n 's/^header = //p' "$cfg" >"$h"
rc=0; "$FAKES/endpoint" "$url" "$h" "$b" || rc=$?; rm -f "$h"; exit $rc
